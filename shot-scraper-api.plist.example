<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shotpowerscraper.api</string>
    <key>ProgramArguments</key>
    <array>
        <string>python3</string>
        <string>/PATH/TO/shot-power-scraper/api_server.py</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8123</string>
        <!-- Add browser arguments here if needed:
        <string>--browser-arg</string>
        <string>--window-size=1920,1080</string>
        -->
    </array>
    <key>WorkingDirectory</key>
    <string>/PATH/TO/shot-power-scraper</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/PATH/TO/shot-power-scraper/api-server.log</string>
    <key>StandardErrorPath</key>
    <string>/PATH/TO/shot-power-scraper/api-server-error.log</string>
</dict>
</plist>